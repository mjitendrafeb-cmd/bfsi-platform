[{"pressReleaseTitle":"India Ratings Affirms Star Health and Allied Insurance Company at ‘IND AA+’/Stable and its Sub-debt at ‘IND AA’/Stable","effectiveDate":"Sep 28, 2026 | Star Health And Allied Insurance Company Limited","overview":" <div> <p> India Ratings and Research (Ind-Ra) has affirmed Star Health and Allied Insurance Company Limited’s (Star) Issuer Rating at ‘IND AA+’. The Outlook is Stable. The detailed rating actions are as follows: </p> </div> ","thumbNailImagePath":"https://www.indiaratings.co.in/data/Uploads/PressReleases/85940/Images/1.jpg","primaryAnalystName":"Jinay Gala"}]