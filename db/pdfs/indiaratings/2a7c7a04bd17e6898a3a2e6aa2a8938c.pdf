[{"pressReleaseTitle":"India Ratings Upgrades EarlySalary Services’ NCDs to ‘IND A’/Stable","effectiveDate":"Oct 06, 2026 | Earlysalary Services Pvt. Ltd.","overview":" <div> <p> India Ratings and Research (Ind-Ra) has upgraded the rating on EarlySalary Services Pvt. Ltd’s (ESPL) non-convertible debentures (NCDs) to ‘IND A’ from ‘IND A-’, with a Stable Outlook, as follows:<br><br></p> </div> ","thumbNailImagePath":null,"primaryAnalystName":"Pankaj Naik"}]