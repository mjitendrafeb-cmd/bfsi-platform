[{"pressReleaseTitle":"India Ratings Revises Outlook on SBFC Finance’s NCDs & Bank Loan Facilities to Positive; Affirms Existing Debt at ‘IND AA-’; Rates Additional Limits","effectiveDate":"Sep 30, 2026 | SBFC Finance Limited","overview":" <div> <p> India Ratings and Research (Ind-Ra) has revised the Outlook on SBFC Finance Limited’s (SBFC) non-convertible debentures (NCDs) and bank loan facilities to Positive from Stable, while affirming long-term debt rating at ‘IND AA-’. The detailed rating actions are as follows: </p> </div> ","thumbNailImagePath":null,"primaryAnalystName":"Ravi Udeshi"}]