[{"pressReleaseTitle":"Update on Punjab National Bank ","effectiveDate":"Oct 01, 2026 | Punjab National Bank","overview":"<p class=\"MsoNormal\" style=\"text-align: justify; margin-bottom: 0in; line-height: normal;\"><span lang=\"EN-IN\">India Ratings and Research (Ind-Ra) has taken cognisance of Punjab\r\nNational Bank's (PNB; </span><span lang=\"EN-IN\"><a href=\"https://www.indiaratings.co.in/pressrelease/80387\">‘IND\r\nAAA’/Stable</a></span><span lang=\"EN-IN\">) intimation that an amount of INR8,59,000 (net\r\nof TDS) out of a total payment of INR2,577.0 million could not be made to one\r\nbond holders on 28 September 2026 <span style=\"color:#333333\">due to the\r\nreasons beyond its control</span>. Ind-Ra however has not recognised it as a\r\ndefault, based on the SEBI circular SEBI/HO/ DDHS/DDHS-PoD-3/P/CIR/2024/160 dated\r\n18 November 2024.<br><br><o:p></o:p></span></p>","thumbNailImagePath":null,"primaryAnalystName":"Ankit Jain"}]