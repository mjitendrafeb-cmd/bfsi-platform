                                <div class="class3">
                                    <br>
                                    <label class="lblColor"><br/><b>Press Release</b></label><br/><br/><label style="font-size:15px;font-family:'Times New Roman';"><b>September 08, 2026</b></label><br/><br>
                                    
                                    <label style="font-size:15px;font-family:'Times New Roman';"><b>THE NATIONAL SMALL INDUSTRIES CORPORATION LIMITED</b></label><br>
                                    
